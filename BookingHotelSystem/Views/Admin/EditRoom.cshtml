@model Room
@{
    ViewData["Title"] = "Edit Room";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm"><div class="card-body p-4">
            <h3 class="mb-3">Edit Room</h3>
            <form asp-action="EditRoom" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <partial name="_RoomFields" model="Model" />
                <button class="btn btn-primary">Update</button>
                <a class="btn btn-outline-secondary" asp-action="Index" asp-route-tab="rooms">Cancel</a>
            </form>
        </div></div>
    </div>
</div>
