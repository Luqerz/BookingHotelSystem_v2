@* Senarai bilik untuk pelanggan: cari dan tempah. (Admin urus bilik di Admin Panel.) *@
@model IEnumerable<Room>
@{
    ViewData["Title"] = "Rooms";
}

<h2 class="mb-3">Rooms</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="searchString" value="@ViewBag.Search" class="form-control" placeholder="Search by room number or type..." />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

<div class="card shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>Room No.</th><th>Type</th><th>Price / night</th><th>Status</th><th class="text-end">Action</th></tr>
        </thead>
        <tbody>
        @foreach (var room in Model)
        {
            <tr>
                <td class="fw-bold">@room.RoomNumber</td>
                <td>@room.RoomType</td>
                <td>RM @room.Price.ToString("N2")</td>
                <td>
                    @if (room.IsAvailable) { <span class="badge bg-success">Available</span> }
                    else { <span class="badge bg-secondary">Unavailable</span> }
                </td>
                <td class="text-end">
                    @if (room.IsAvailable)
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.Id">Book</a>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-4">No rooms found.</td></tr>
        }
        </tbody>
    </table>
</div>
